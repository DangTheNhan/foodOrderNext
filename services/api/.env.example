# Local emulators only. No Firebase account credentials are needed or allowed.
FIREBASE_MODE=emulator
FIREBASE_PROJECT_ID=demo-foodordernext
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
FIREBASE_STORAGE_BUCKET=demo-foodordernext.appspot.com
PORT=5000
API_BIND_HOST=127.0.0.1
FCM_SEND_ENABLED=false
# Start a local Ollama daemon before enabling the model.
AI_PROVIDER=disabled
AI_OLLAMA_HOST=127.0.0.1:11434
AI_MODEL=
AI_TIMEOUT_MS=16000
AI_CPU_ONLY=false
